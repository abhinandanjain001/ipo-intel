rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /users/{uid}/holdings/{holdingId} {
   function owner() { return request.auth != null && request.auth.uid == uid; }
   function valid() {
    let d = request.resource.data;
    return d.keys().hasAll(['name','quantity','entry','mark','fees','status','date','note'])
     && d.keys().hasOnly(['name','quantity','entry','mark','fees','status','date','note'])
     && d.name is string && d.name.size() > 0 && d.name.size() <= 120
     && d.quantity is int && d.quantity > 0 && d.quantity <= 100000000
     && d.entry is number && d.entry > 0 && d.entry <= 100000000
     && (d.mark == null || (d.mark is number && d.mark >= 0 && d.mark <= 100000000))
     && d.fees is number && d.fees >= 0 && d.fees <= 100000000
     && d.status in ['Held','Sold'] && (d.status != 'Sold' || d.mark != null)
     && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
     && d.note is string && d.note.size() <= 500;
   }
   allow read, delete: if owner();
   allow create, update: if owner() && valid();
  }
 }
}
